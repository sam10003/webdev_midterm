# ── Server ─────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# development | test | production — use test + WIPE_DB_ON_BOOT for a clean DB each boot
APP_MODE=development
WIPE_DB_ON_BOOT=false

# Optional: frontend URL for CORS / Socket.IO (or set CORS_ORIGINS)
CLIENT_URL=http://localhost:5173
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── MongoDB ─────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# ── JWT ─────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
# Optional overrides (defaults: 15m / 7d)
# JWT_EXPIRY=15m
# JWT_REFRESH_EXPIRY=7d

# ── Email (Nodemailer — verification code on POST /api/user/register) ──
# If SMTP_HOST is unset or send fails, the user is still created; errors are logged.
# In NODE_ENV=development, the code is printed when email was not sent; set LOG_VERIFICATION_CODE=true
# to also print the code when send succeeds (debug only).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@yourdomain.com
# LOG_VERIFICATION_CODE=false

# ── Slack (5xx alerts — final project) ─────────────────────
# Incoming Webhook URL. Uncaught / non-AppError errors (500) POST here; 4xx AppErrors are not sent.
# Disabled automatically when NODE_ENV=test (Jest).
SLACK_WEBHOOK_URL=

# ── Generated PDFs (delivery notes) ─────────────────────────
# Relative to project root. Files stored at ${PDF_STORAGE_DIR}/<noteId>.pdf
# PDF_STORAGE_DIR=uploads/pdfs

# ── Swagger ────────────────────────────────────────────────
# SWAGGER_PATH=/api-docs

# ── Testing (Jest) ───────────────────────────────────────────
# `npm test` uses mongodb-memory-server in tests/setup.js — it sets MONGO_URI to an ephemeral
# in-memory instance. Your real MONGO_URI above is NOT used by Jest (production/Atlas is safe).
# JWT_SECRET / JWT_REFRESH_SECRET can be unset for tests (setup.js sets dev defaults).
